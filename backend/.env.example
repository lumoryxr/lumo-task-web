# ── Required (every environment) ──────────────────────────────────────────────
# These placeholders are REJECTED at boot — you must replace both with real
# random values (>= 32 bytes). Generate each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT signing secret
LUMO_JWT_SECRET=change-me-in-production-use-32+-random-bytes

# At-rest encryption key for AI keys + sync tokens (AES-256-GCM)
LUMO_ENCRYPTION_KEY=change-me-in-production-use-32+-random-bytes

# ── Optional / defaults shown ─────────────────────────────────────────────────

# Port the backend listens on (default: 47291)
LUMO_PORT=47291

# Comma-separated allowed CORS origins (in addition to localhost/127.0.0.1)
# Examples: "https://app.example.com,https://lumo-task-frontend.onrender.com"
LUMO_ALLOWED_ORIGINS=

# Node environment (development | production)
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum log level to emit: debug | info | warn | error | silent (default info).
# See docs/ops/logging.md for the structured-log schema, redaction, and audit log.
LUMO_LOG_LEVEL=info
# Stamped on every log line as `version` (for correlating logs to a release).
LUMO_VERSION=1.0.0

# ── Transactional email (password reset) ──────────────────────────────────────
# Without a provider configured, password-reset emails are NOT sent: in dev the
# message is captured in-memory (and logged); in production a loud error is
# logged and nothing is sent. Set these to enable real delivery.
#
# Provider selector — currently supported: "resend"
LUMO_EMAIL_PROVIDER=
# Resend API key (https://resend.com) — required when LUMO_EMAIL_PROVIDER=resend
LUMO_RESEND_API_KEY=
# From address for outbound email, e.g. "Lumo <no-reply@yourdomain.com>"
LUMO_EMAIL_FROM=
# Absolute base URL of the web app, used to build the reset link in emails
# (default: https://lumo-task-frontend.onrender.com)
LUMO_APP_BASE_URL=
