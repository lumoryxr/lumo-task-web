# ── Required in production ────────────────────────────────────────────────────

# JWT signing secret — min 32 random bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUMO_JWT_SECRET=change-me-in-production-use-32+-random-bytes

# ── Optional / defaults shown ─────────────────────────────────────────────────

# Port the backend listens on (default: 47291)
LUMO_PORT=47291

# Comma-separated allowed CORS origins (in addition to localhost/127.0.0.1)
# Examples: "https://app.example.com,.vercel.app"
LUMO_ALLOWED_ORIGINS=

# Node environment (development | production)
NODE_ENV=development
