{
  "name": "lumo-task-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npx esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs \"--external:node:*\" \"--external:libsql\"",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "backup": "tsx src/db/backup.ts",
    "start": "node dist/index.js",
    "test": "node --env-file src/test/.env.test --import tsx/esm --test \"src/test/api/**/*.test.ts\"",
    "test:unit": "node --env-file src/test/.env.test --import tsx/esm --test \"src/test/api/**/*.test.ts\"",
    "test:coverage": "node --env-file src/test/.env.test --import tsx/esm --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=78 --test-coverage-functions=75 \"src/test/api/**/*.test.ts\"",
    "test:security": "node --env-file src/test/.env.test --import tsx/esm --test \"src/test/security/**/*.security.test.ts\"",
    "test:standards": "node --env-file src/test/.env.test --import tsx/esm --test \"src/test/standards/**/*.standards.test.ts\"",
    "test:integration": "node --env-file src/test/.env.integration --import tsx/esm --test src/test/integration.test.ts",
    "test:dfx": "node --env-file src/test/.env.integration --import tsx/esm --test src/test/dfx.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.8.0",
    "@libsql/client": "^0.17.4",
    "@lumo/contracts": "file:../packages/contracts",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.27",
    "jose": "^5.10.0",
    "nanoid": "^5.1.16",
    "undici": "^7.28.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
