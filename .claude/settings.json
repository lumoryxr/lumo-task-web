{
  "permissions": {
    "allow": [
      "Bash(cd *lumo-task-web/web-app* && npm test*)",
      "Bash(cd *lumo-task-web/backend* && npm test*)",
      "Bash(cd *lumo-task-web/web-app* && npm run typecheck*)",
      "Bash(cd *lumo-task-web/backend* && npm run typecheck*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests-on-save.js\"",
            "timeout": 120,
            "statusMessage": "Running ECC typecheck..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true
  }
}
