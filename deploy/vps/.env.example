# Lumo — self-hosted VPS environment.
#
# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit the filled
# `.env` (deploy/vps/.env is gitignored). Generate the two crypto secrets with:
#   openssl rand -hex 32
#
# See docs/ops/vps-deployment.md for the full walkthrough.

# ── Required ─────────────────────────────────────────────────────────────────

# Your domain (used for the reverse proxy / TLS and for email + OAuth links).
LUMO_DOMAIN=app.example.com

NODE_ENV=production

# Auth + at-rest encryption secrets. 32+ bytes each, unique, secret. Rotating
# LUMO_JWT_SECRET signs everyone out; rotating LUMO_ENCRYPTION_KEY makes stored
# secrets (AI keys, sync tokens) unreadable — treat both as permanent.
LUMO_JWT_SECRET=
LUMO_ENCRYPTION_KEY=

# CORS allow-list. With the single-process image (SPA served same-origin) you do
# NOT need this; set it only if the SPA is served from a different origin than
# the API. Comma-separated origins, e.g. https://app.example.com
LUMO_ALLOWED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# Default (recommended for a single-VPS beta): a local SQLite file on a mounted
# cloud disk. Persistence comes from the disk, so the DB survives every redeploy
# and is trivial to back up (it's a plain SQLite file). Migrations run
# automatically on first boot.
#
# LUMO_DATA_DIR is the HOST path where your provider's block/cloud disk is
# mounted. docker-compose bind-mounts it to /data inside the container, and the
# app writes the DB at /data/lumo.db (LUMO_DB_PATH, set by compose). The disk must
# be writable by the app user (uid 1000). You normally don't do anything: the
# container's entrypoint self-heals the ownership on startup (and bootstrap.sh
# also chowns it as a fast path).
LUMO_DATA_DIR=/mnt/lumo-data

# Escape hatch for network/cloud disks that REFUSE chown (they enforce a fixed
# owner). Symptom: the app can't open the DB — `SQLITE_CANTOPEN (14)` — even after
# the entrypoint tried to chown /data. Find the owner the mount grants
# (`stat -c '%u:%g' /mnt/lumo-data`) and set these to it, then restart. The app
# then runs as that uid/gid instead of fighting the disk. Leave unset otherwise.
# LUMO_UID=1000
# LUMO_GID=1000

# Alternative: hosted Turso (libsql) instead of a local disk. Set BOTH of these
# and the backend switches to direct-cloud mode (it takes precedence over the
# local file). Set BOTH or NEITHER — it refuses to boot with only one.
#   turso db create lumo && turso db show --url lumo && turso db tokens create lumo
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public base URL of this deployment — used to build password-reset / email
# verification links and the OAuth callback origin. e.g. https://app.example.com
LUMO_APP_BASE_URL=

# ── Feedback admin (in-app feedback review) ──────────────────────────────────
# Comma-separated emails allowed to review/triage in-app feedback (case-
# insensitive). The account must sign in with a bound email in this list.
# Leave empty to collect feedback but expose no in-app admin surface yet.
LUMO_ADMIN_EMAILS=

# ── Logging ──────────────────────────────────────────────────────────────────
# JSON-line log verbosity: debug | info | warn | error | silent (default info).
LUMO_LOG_LEVEL=info
# If set, also append every log line to this file (in addition to stdout). Point
# it at a mounted volume so logs survive container restarts, then rotate with
# logrotate. e.g. /var/log/lumo/backend.log
LUMO_LOG_FILE=

# ── Optional (features degrade cleanly when unset) ───────────────────────────

# Transactional email (password reset, verification). Without a provider the
# backend uses a dev "outbox" (logs the mail) — fine for a private beta.
LUMO_EMAIL_PROVIDER=          # "resend" to enable real delivery
LUMO_EMAIL_FROM=              # verified sender, e.g. "Lumo <no-reply@example.com>"
LUMO_RESEND_API_KEY=          # https://resend.com API key (when provider=resend)

# Shared server-side AI key (Anthropic). Unset = users bring their own key only.
LUMO_AI_KEY=
LUMO_AI_CLOUD_GLOBAL_CAP=     # aggregate AI calls/month across all users; unset = no cap

# GitHub login (web only). All three required to enable; unset = button hidden.
LUMO_GITHUB_CLIENT_ID=
LUMO_GITHUB_CLIENT_SECRET=
LUMO_GITHUB_CALLBACK_URL=     # https://app.example.com/v1/auth/github/callback

# Prometheus /metrics bearer token. Unset = /metrics is disabled.
LUMO_METRICS_TOKEN=

# Frontend API base, inlined into the SPA at BUILD time. For the single-process
# image the SPA is same-origin, so "/v1" is correct. Change only if you serve
# the SPA from a different origin than the API.
VITE_API_BASE=/v1
