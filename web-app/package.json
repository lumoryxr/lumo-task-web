{
  "name": "lumo-task-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "package:win": "electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers playwright test",
    "test:e2e:report": "PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers playwright show-report",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:integration:report": "playwright show-report playwright-report-integration",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:electron:report": "playwright show-report playwright-report-electron"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.15.0",
    "@lumo/contracts": "file:../packages/contracts",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "solarlunar": "^3.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "zod": "^3.24.4",
    "vite": "^5.4.6",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.lumo.task",
    "productName": "Lumo Task",
    "artifactName": "LumoTask-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/bundle.cjs",
        "to": "backend/bundle.cjs"
      },
      {
        "from": "../backend/node_modules/@libsql",
        "to": "backend/node_modules/@libsql",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/node_modules/libsql",
        "to": "backend/node_modules/libsql",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/node_modules/@neon-rs",
        "to": "backend/node_modules/@neon-rs",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/node_modules/detect-libc",
        "to": "backend/node_modules/detect-libc",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "resources/backend/node_modules/**/*.node",
      "resources/backend/node_modules/**/*.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "include": "build/installer.nsh"
    }
  }
}
