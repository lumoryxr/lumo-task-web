{
  "name": "@lumo/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for the Lumo API contract (Zod schemas shared by backend + web-app).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "gen:openapi": "tsx src/scripts/gen-openapi.ts",
    "test": "node --import tsx/esm --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3"
  }
}
