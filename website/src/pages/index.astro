---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import Hooks from "../components/Hooks.astro";
import Bento from "../components/Bento.astro";
import Steps from "../components/Steps.astro";
import ShowcaseSplit from "../components/ShowcaseSplit.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="Lumo — Turn what you should do into what you want to do"
  description="Lumo is a free, open-source task companion: Eisenhower matrix, Pomodoro focus, AI planning, OKR goals and a pet that grows as you finish. Bilingual EN/中文."
>
  <Nav />
  <main>
    <Hero />
    <TrustBar />
    <Hooks />
    <Bento />
    <Steps />
    <ShowcaseSplit />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Base>
