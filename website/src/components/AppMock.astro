---
// Beautified "Today" screen — hand-built mock (not a screenshot).
---
<div class="mock" role="img" aria-label="Lumo Today view preview">
  <div class="mock-top">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <div class="mock-url"><span data-i18n-en>lumo · today</span><span data-i18n-zh>lumo · 今天</span></div>
  </div>

  <div class="mock-body">
    <aside class="mock-side">
      <div class="side-item active">🗓️</div>
      <div class="side-item">▦</div>
      <div class="side-item">🎯</div>
      <div class="side-item">🔥</div>
      <div class="side-item">📊</div>
    </aside>

    <div class="mock-main">
      <div class="mock-head">
        <div>
          <div class="mh-eyebrow" data-i18n-en>THURSDAY · JULY 4</div>
          <div class="mh-eyebrow" data-i18n-zh>周四 · 7月4日</div>
          <div class="mh-title" data-i18n-en>Good afternoon, Jalen</div>
          <div class="mh-title" data-i18n-zh>下午好,Jalen</div>
        </div>
        <div class="ring">
          <svg viewBox="0 0 44 44" width="44" height="44">
            <circle cx="22" cy="22" r="18" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="5"/>
            <circle cx="22" cy="22" r="18" fill="none" stroke="var(--accent)" stroke-width="5"
              stroke-linecap="round" stroke-dasharray="113" stroke-dashoffset="34"
              transform="rotate(-90 22 22)"/>
          </svg>
          <span class="ring-num">70%</span>
        </div>
      </div>

      <div class="task hi">
        <span class="chk on">✓</span>
        <span class="t-txt"><b class="kw">今天</b> 提交 M1 需求评审 · <b class="kw">15:00</b></span>
        <span class="pill q1">Q1</span>
      </div>
      <div class="task">
        <span class="chk"></span>
        <span class="t-txt" data-i18n-en>Reply to design feedback · <b class="kw">urgent</b></span>
        <span class="t-txt" data-i18n-zh>回复设计反馈 · <b class="kw">紧急</b></span>
        <span class="pill q2">Q2</span>
      </div>
      <div class="task">
        <span class="chk"></span>
        <span class="t-txt" data-i18n-en>Draft weekly report · due <b class="kw">tomorrow</b></span>
        <span class="t-txt" data-i18n-zh>起草周报 · <b class="kw">明天</b>截止</span>
        <span class="pill q2">Q2</span>
      </div>
      <div class="task dim">
        <span class="chk"></span>
        <span class="t-txt" data-i18n-en>Read industry newsletter</span>
        <span class="t-txt" data-i18n-zh>读行业周刊</span>
        <span class="pill q4">Q4</span>
      </div>

      <div class="focus-bar">
        <span class="fb-ico">🍅</span>
        <span data-i18n-en>Focus · 18:24 left</span>
        <span data-i18n-zh>专注中 · 剩 18:24</span>
        <span class="fb-track"><span class="fb-fill"></span></span>
      </div>
    </div>
  </div>

  <div class="pet">
    <span class="pet-face">🦊</span>
    <span class="pet-spark">✨</span>
  </div>
</div>

<style>
  .mock {
    position: relative;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #12131b, #0b0c12);
    border: 1px solid var(--border-strong);
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
    overflow: hidden;
  }
  .mock-top {
    display: flex; align-items: center; gap: 7px;
    padding: 12px 16px; border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot.r { background: #ff5f57; } .dot.y { background: #febc2e; } .dot.g { background: #28c840; }
  .mock-url {
    margin-left: 12px; font-size: 12px; color: var(--text-muted);
    background: rgba(255,255,255,0.04); padding: 4px 12px; border-radius: 999px;
  }
  .mock-body { display: grid; grid-template-columns: 52px 1fr; min-height: 340px; }
  .mock-side {
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    padding: 18px 0; border-right: 1px solid var(--border); background: rgba(0,0,0,0.2);
  }
  .side-item {
    width: 34px; height: 34px; display: grid; place-items: center;
    border-radius: 10px; font-size: 15px; opacity: 0.5;
  }
  .side-item.active { opacity: 1; background: rgba(52,211,153,0.14); box-shadow: inset 0 0 0 1px rgba(52,211,153,0.3); }
  .mock-main { padding: 20px 22px; }
  .mock-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; }
  .mh-eyebrow { font-size: 11px; letter-spacing: 0.08em; color: var(--text-muted); font-weight: 600; }
  .mh-title { font-size: 19px; font-weight: 800; margin-top: 3px; }
  .ring { position: relative; display: grid; place-items: center; }
  .ring-num { position: absolute; font-size: 11px; font-weight: 700; }

  .task {
    display: flex; align-items: center; gap: 11px;
    padding: 11px 13px; margin-bottom: 8px;
    background: rgba(255,255,255,0.03); border: 1px solid var(--border);
    border-radius: 12px; font-size: 13.5px; color: var(--text-soft);
  }
  .task.hi { border-color: rgba(52,211,153,0.35); box-shadow: 0 0 24px -10px var(--glow-teal); }
  .task.dim { opacity: 0.55; }
  .chk {
    width: 18px; height: 18px; border-radius: 6px; flex: none;
    border: 1.5px solid var(--text-faint); display: grid; place-items: center;
    font-size: 11px; color: transparent;
  }
  .chk.on { background: var(--accent); border-color: var(--accent); color: #04120c; }
  .t-txt { flex: 1; }
  .kw { color: var(--accent); font-weight: 700; }
  .pill { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 999px; flex: none; }
  .pill.q1 { color: #ff8f8f; background: rgba(255,90,90,0.14); }
  .pill.q2 { color: #ffd27a; background: rgba(251,191,36,0.14); }
  .pill.q4 { color: var(--text-muted); background: rgba(255,255,255,0.06); }

  .focus-bar {
    display: flex; align-items: center; gap: 10px; margin-top: 14px;
    padding: 10px 14px; border-radius: 12px; font-size: 12.5px; color: var(--text-soft);
    background: linear-gradient(90deg, rgba(139,123,255,0.14), rgba(52,211,153,0.1));
    border: 1px solid rgba(139,123,255,0.24);
  }
  .fb-track { flex: 1; height: 5px; border-radius: 999px; background: rgba(255,255,255,0.1); overflow: hidden; }
  .fb-fill { display: block; height: 100%; width: 62%; background: linear-gradient(90deg, var(--violet), var(--accent)); }

  .pet {
    position: absolute; right: 16px; bottom: 16px;
    width: 52px; height: 52px; display: grid; place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 30%, rgba(52,211,153,0.35), rgba(139,123,255,0.2));
    border: 1px solid rgba(255,255,255,0.16);
    box-shadow: 0 8px 30px -8px var(--glow-teal);
    animation: petbob 3.4s var(--ease) infinite;
  }
  .pet-face { font-size: 26px; }
  .pet-spark { position: absolute; top: -6px; right: -4px; font-size: 14px; animation: twinkle 2.2s ease infinite; }

  @keyframes petbob { 0%,100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-6px) rotate(3deg); } }
  @keyframes twinkle { 0%,100% { opacity: 0.4; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1.15); } }

  @media (max-width: 520px) {
    .mock-body { grid-template-columns: 44px 1fr; }
    .mock-main { padding: 16px; }
  }
</style>
