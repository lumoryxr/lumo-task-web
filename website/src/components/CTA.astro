---
const app = "https://lumoryxr.duckdns.org";
const releasesLatest = "https://github.com/lumoryxr/lumo-task-web/releases/latest";
---
<section class="cta-sec">
  <div class="wrap">
    <div class="cta reveal">
      <div class="cta-glow" aria-hidden="true"></div>
      <span class="cta-pet">🦊</span>
      <h2 class="cta-title">
        <span data-i18n-en>Ready to want your to-do list?</span>
        <span data-i18n-zh>准备好,爱上你的待办清单了吗?</span>
      </h2>
      <p class="cta-sub">
        <span data-i18n-en>Free forever. Open source. Start in seconds — your pet is waiting.</span>
        <span data-i18n-zh>永久免费,开源。几秒钟就能开始 —— 你的宠物在等你。</span>
      </p>
      <div class="cta-ctas">
        <a class="btn btn-primary btn-lg" href={app} target="_blank" rel="noopener">
          <span data-i18n-en>Open web app</span><span data-i18n-zh>打开网页版</span>
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost btn-lg btn-win" data-win-download href={releasesLatest} target="_blank" rel="noopener">
          <svg class="win-glyph" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.4 10.3 4.4v7.05H3V5.4Zm0 13.2 7.3 1v-7.05H3v6.05Zm8.4 1.15L21 21.1V12.6h-9.6v7.15Zm0-15.5v7.15H21V2.9l-9.6 1.35Z"/></svg>
          <span data-i18n-en>Download for Windows</span><span data-i18n-zh>下载 Windows 版</span>
          <span class="win-ver" data-win-ver aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-sec { padding: 40px 0 80px; }
  .cta {
    position: relative; text-align: center; overflow: hidden;
    padding: 64px 32px; border-radius: var(--radius-xl);
    background: linear-gradient(160deg, #14161f, #0a0b11);
    border: 1px solid var(--border-strong);
  }
  .cta-glow {
    position: absolute; inset: 0; z-index: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 0%, var(--glow-teal), transparent 70%);
    opacity: 0.5;
  }
  .cta > * { position: relative; z-index: 1; }
  .cta-pet { font-size: 46px; display: inline-block; animation: petbob 3.4s var(--ease) infinite; }
  .cta-title { font-size: clamp(26px, 4vw, 40px); font-weight: 900; letter-spacing: -0.02em; margin: 14px 0 12px; }
  .cta-sub { font-size: 16px; color: var(--text-soft); max-width: 480px; margin: 0 auto 28px; }
  .cta-ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .btn-lg { padding: 16px 34px; font-size: 16px; }
  @keyframes petbob { 0%,100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-6px) rotate(3deg); } }
</style>
